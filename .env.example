# Скопіюй цей файл під назвою .env і заповни значення.
# УВАГА: файл .env у Git НЕ потрапляє — у ньому пароль.

# ⚠ Назва бази залежить від КЛАСУ:
#     11-А  ->  Gurtky_A
#     11-Б  ->  Gurtky_B
DB_DATABASE=Gurtky_A

DB_SERVER=
DB_USER=
DB_PASSWORD=

# Джерело даних: mssql (справжня база) або json (резервний план дня 15)
DATA_SOURCE=mssql
DATA_FILE=data/clubs.json

# Порт сервера
PORT=3000
